<?xml version="1.0"?>

<robot name="kopterworx_gummy" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Force sensor (enabled by default for gummy effectors) -->
  <xacro:arg name="enable_force" default="true" />
  <xacro:property name="enable_force" value="$(arg enable_force)" />

  <!-- Pole tip shape - sphere optimized for soft contact -->
  <xacro:arg name="box_tip" default="false" />
  <xacro:property name="box_tip" value="$(arg box_tip)" />
  <xacro:arg name="sphere_tip" default="true" />
  <xacro:property name="sphere_tip" value="$(arg sphere_tip)" />
  <xacro:arg name="cylinder_tip" default="false" />
  <xacro:property name="cylinder_tip" value="$(arg cylinder_tip)" />

  <!-- Pole tip direction-->
  <xacro:arg name="x_axis" default="false" />
  <xacro:property name="x_axis" value="$(arg x_axis)" />
  <xacro:arg name="z_axis" default="false" />
  <xacro:property name="z_axis" value="$(arg z_axis)" />

  <!-- Math constants -->
  <xacro:property name="sin45" value="0.7071068" />
  <xacro:property name="cos45" value="0.7071068" />

  <!-- Body Properties -->
  <xacro:property name="rotor_velocity_slowdown_sim" value="15" />
  <xacro:property name="mesh_file" value="ardupilot_gazebo/models/kopterworx/meshes/kopterworx_model_simple.dae" />
  <xacro:property name="mesh_scale" value="0.1" />
  <xacro:property name="prop_scale" value="0.003" />
  <xacro:property name="mass" value="9" />  <!-- [kg] -->
  <xacro:property name="body_width" value="0.3" /> <!-- [m] -->
  <xacro:property name="body_height" value="0.6" /> <!-- [m] -->
  <xacro:property name="arm_length" value="0.52" /> <!-- [m] -->
  <xacro:property name="rotor_x_offset" value="${arm_length*cos45}" /> <!-- [m] -->
  <xacro:property name="rotor_y_offset" value="${arm_length*sin45}" /> <!-- [m] -->
  <xacro:property name="rotor_offset_top" value="0.115" /> <!-- [m] -->

  <!-- Properties of the main pole -->
  <xacro:property name="pole_radius" value="0.01" />  <!-- [m] -->
  <xacro:arg name="pole_length" default="0.8" />  <!-- [m] -->
  <xacro:property name="pole_length" value="$(arg pole_length)" />  
  <xacro:property name="pole_mount_height" value="0.25" />  <!-- [m] -->

  <!-- Properties of the branch poles (left and right) -->
  <xacro:property name="branch_pole_length" value="0.3" />  <!-- [m] -->
  <xacro:property name="pole_separation" value="0.4" />  <!-- [m] - 40cm separation between left and right tips -->
  <xacro:property name="branch_offset" value="0.2" />  <!-- [m] - half of separation, for positioning left/right branches -->

  <!-- Mass of the pole -->
  <xacro:property name="pole_mass" value="0.02" /> <!-- [kg] -->
  <xacro:property name="branch_mass" value="0.01" /> <!-- [kg] -->

  <!-- Properties of GUMMY/SOFT sensor end effector -->
  <!-- Single soft sphere - unified deformable contact -->
  <xacro:property name="gummy_sphere_radius" value="0.05" /> <!-- [m] - main soft gummy sphere -->
  <xacro:property name="gummy_sphere_mass" value="0.015" /> <!-- [kg] - soft material mass -->

  <!-- Contact/Material properties for gummy (soft, compliant) -->
  <xacro:property name="gummy_friction" value="0.4" /> <!-- Moderate friction for grip -->
  <xacro:property name="gummy_restitution" value="0.0005" /> <!-- Very low bounce (soft material) -->
  
  <!-- Soft contact damping/stiffness (Gazebo ODE parameters) -->
  <!-- Low stiffness = more deformation, higher damping = dissipates energy -->
  <xacro:property name="gummy_contact_cfm" value="0.05" /> <!-- Constraint force mixing - higher = softer -->
  <xacro:property name="gummy_contact_erp" value="0.2" /> <!-- Error reduction parameter - lower = softer response -->

  <!-- Rotor constants -->
  <xacro:property name="mass_rotor" value="0.01" /> <!-- [kg] -->
  <xacro:property name="radius_rotor" value="0.285" /> <!-- [m] -->
  <xacro:property name="motor_constant" value="2.440724623743665e-04" /> <!-- [kg*m/s^2] -->
  <xacro:property name="moment_constant" value="0.044148079282817" /> <!-- [m] -->
  <xacro:property name="time_constant_up" value="0.0125" /> <!-- [s] -->
  <xacro:property name="time_constant_down" value="0.0125" /> <!-- [s] -->
  <xacro:property name="max_rot_velocity" value="667" /> <!-- [rad/s] -->
  <xacro:property name="rotor_drag_coefficient" value="8.06428e-05" />
  <xacro:property name="rolling_moment_coefficient" value="0.000001" />

  <!-- Collision bitmask -->
  <xacro:arg name="collision_bitmask" default="-1" />
  <xacro:property name="collision_bitmask" value="$(arg collision_bitmask)" />

  <!-- Property Blocks -->
  <xacro:property name="body_inertia">  
    <inertia ixx="0.303755" ixy="0.0004484919" ixz="0.0010159727" iyy="0.27722" iyz="-0.001806885" izz="0.469164" />
  </xacro:property>

  <!-- inertia of a single rotor -->
  <xacro:property name="rotor_inertia">
    <xacro:box_inertia x="${radius_rotor}" y="0.015" z="0.003" mass="${mass_rotor*rotor_velocity_slowdown_sim}" />
  </xacro:property>
  
  <!-- Included URDF Files -->
  <xacro:include filename="$(find ardupilot_gazebo)/models/util/multirotor_base.urdf.xacro" />

  <!-- Instantiate multirotor_base_macro once -->
  <xacro:multirotor_base_macro
    robot_namespace="$(arg namespace)"
    mass="${mass}"
    body_width="${body_width}"
    body_height="${body_height}"
    mesh_file="${mesh_file}"
    mesh_scale="${mesh_scale}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <xacro:insert_block name="body_inertia" />
  </xacro:multirotor_base_macro>

  <!-- Instantiate rotors -->
  <xacro:vertical_rotor
    robot_namespace="$(arg namespace)"
    suffix="front_left"
    direction="cw"
    motor_constant="${motor_constant}"
    moment_constant="${moment_constant}"
    parent="$(arg namespace)/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    time_constant_up="${time_constant_up}"
    time_constant_down="${time_constant_down}"
    max_rot_velocity="${max_rot_velocity}"
    motor_number="1"
    rotor_drag_coefficient="${rotor_drag_coefficient}"
    rolling_moment_coefficient="${rolling_moment_coefficient}"
    color="Red"
    prop_scale="${prop_scale}">
    <origin xyz="${rotor_x_offset} ${rotor_y_offset} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="$(arg namespace)"
    suffix="front_right"
    direction="ccw"
    motor_constant="${motor_constant}"
    moment_constant="${moment_constant}"
    parent="$(arg namespace)/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    time_constant_up="${time_constant_up}"
    time_constant_down="${time_constant_down}"
    max_rot_velocity="${max_rot_velocity}"
    motor_number="0"
    rotor_drag_coefficient="${rotor_drag_coefficient}"
    rolling_moment_coefficient="${rolling_moment_coefficient}"
    color="Blue"
    prop_scale="${prop_scale}">
    <origin xyz="${rotor_x_offset} -${rotor_y_offset} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="$(arg namespace)"
    suffix="back_left"
    direction="ccw"
    motor_constant="${motor_constant}"
    moment_constant="${moment_constant}"
    parent="$(arg namespace)/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    time_constant_up="${time_constant_up}"
    time_constant_down="${time_constant_down}"
    max_rot_velocity="${max_rot_velocity}"
    motor_number="2"
    rotor_drag_coefficient="${rotor_drag_coefficient}"
    rolling_moment_coefficient="${rolling_moment_coefficient}"
    color="Blue"
    prop_scale="${prop_scale}">
    <origin xyz="-${rotor_x_offset} ${rotor_y_offset} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="$(arg namespace)"
    suffix="back_right"
    direction="cw"
    motor_constant="${motor_constant}"
    moment_constant="${moment_constant}"
    parent="$(arg namespace)/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    time_constant_up="${time_constant_up}"
    time_constant_down="${time_constant_down}"
    max_rot_velocity="${max_rot_velocity}"
    motor_number="3"
    rotor_drag_coefficient="${rotor_drag_coefficient}"
    rolling_moment_coefficient="${rolling_moment_coefficient}"
    color="Red"
    prop_scale="${prop_scale}">
    <origin xyz="-${rotor_x_offset} -${rotor_y_offset} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <!-- ============================================================================ -->
  <!-- GUMMY END EFFECTORS WITH FORCE SENSING - T MANIPULATOR -->
  <!-- FINAL FIX: Right sensor uses Y-axis to ensure consistent positive measurements -->
  <!-- ============================================================================ -->
  
  <xacro:if value="$(arg enable_force)">
    
    <!-- ========== MAIN POLE (vertical from robot center) ========== -->
    
    <joint name="$(arg namespace)/pole_base_joint" type="fixed">
      <parent link="$(arg namespace)/base_link"/>
      <child link="$(arg namespace)/pole_base"/>
      <origin xyz="0 0 ${pole_mount_height}" rpy="0 0 0"/>
    </joint>

    <link name="$(arg namespace)/pole_base">
      <visual>
        <xacro:if value="$(arg x_axis)">
          <origin xyz="${pole_length/2} 0 0" rpy="0 1.57 0"/>
        </xacro:if>
        <xacro:if value="$(arg z_axis)">
          <origin xyz="0 0 -${pole_length/2}" rpy="0 0 0"/>
        </xacro:if>
        <geometry>
          <cylinder length="${pole_length}" radius="${pole_radius}" />
        </geometry>
        <material name="green">
          <color rgba="0.2 1 0.2 1"/>
        </material>
      </visual>

      <collision>
        <xacro:if value="$(arg x_axis)">
          <origin xyz="${pole_length/2} 0 0" rpy="0 1.57 0"/>
        </xacro:if>
        <xacro:if value="$(arg z_axis)">
          <origin xyz="0 0 -${pole_length/2}" rpy="0 0 0"/>
        </xacro:if>
        <geometry>
          <cylinder length="${pole_length}" radius="${pole_radius}" />
        </geometry>
      </collision>

      <inertial>
        <xacro:if value="$(arg x_axis)">
          <origin xyz="${pole_length/2} 0 0" rpy="0 1.57 0"/>
        </xacro:if>
        <xacro:if value="$(arg z_axis)">
          <origin xyz="0 0 -${pole_length/2}" rpy="0 0 0"/>
        </xacro:if>
        <mass value="${pole_mass}" />
        <inertia 
          ixx="${(1/12) * pole_mass * (3*pole_radius*pole_radius + pole_length*pole_length)}" 
          ixy="0.0" 
          ixz="0.0"
          iyy="${(1/12) * pole_mass * (3*pole_radius*pole_radius + pole_length*pole_length)}" 
          iyz="0.0" 
          izz="${(1/2) * pole_mass * (pole_radius*pole_radius)}" />
      </inertial>
    </link>

    <!-- ========== BRANCH JUNCTION LINK ========== -->
    <!-- T-junction where main pole branches to left and right -->
    
    <link name="$(arg namespace)/branch_junction">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
        <material name="yellow">
          <color rgba="1 1 0 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="$(arg namespace)/junction_joint" type="fixed">
      <parent link="$(arg namespace)/pole_base"/>
      <child link="$(arg namespace)/branch_junction"/>
      <xacro:if value="$(arg x_axis)">
        <origin xyz="${pole_length} 0 0" rpy="0 0 0"/>
      </xacro:if>
      <xacro:if value="$(arg z_axis)">
        <origin xyz="0 0 -${pole_length}" rpy="0 0 0"/>
      </xacro:if>
    </joint>

    <!-- ========== LEFT BRANCH POLE ========== -->

    <link name="$(arg namespace)/branch_pole_left">
      <visual>
        <origin xyz="0 -${branch_pole_length/2} 0" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="${branch_pole_length}" radius="${pole_radius}" />
        </geometry>
        <material name="cyan">
          <color rgba="0 1 1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 -${branch_pole_length/2} 0" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="${branch_pole_length}" radius="${pole_radius}" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 -${branch_pole_length/2} 0" rpy="1.57 0 0"/>
        <mass value="${branch_mass}" />
        <inertia 
          ixx="${(1/12) * branch_mass * (3*pole_radius*pole_radius + branch_pole_length*branch_pole_length)}" 
          ixy="0.0" 
          ixz="0.0"
          iyy="${(1/12) * branch_mass * (3*pole_radius*pole_radius + branch_pole_length*branch_pole_length)}" 
          iyz="0.0" 
          izz="${(1/2) * branch_mass * (pole_radius*pole_radius)}" />
      </inertial>
    </link>

    <joint name="$(arg namespace)/branch_joint_left" type="fixed">
      <parent link="$(arg namespace)/branch_junction"/>
      <child link="$(arg namespace)/branch_pole_left"/>
      <origin xyz="0 ${branch_offset} 0" rpy="0 0 0"/>
    </joint>

    <!-- ========== LEFT SOFT GUMMY SPHERE ========== -->

    <link name="$(arg namespace)/gummy_sphere_left">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${gummy_sphere_radius}"/>
        </geometry>
        <material name="gummy_pink">
          <color rgba="0.95 0.6 0.7 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${gummy_sphere_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${gummy_sphere_mass}"/>
        <inertia 
          ixx="${(2/5) * gummy_sphere_mass * gummy_sphere_radius * gummy_sphere_radius}" 
          ixy="0.0" 
          ixz="0.0"
          iyy="${(2/5) * gummy_sphere_mass * gummy_sphere_radius * gummy_sphere_radius}" 
          iyz="0.0"
          izz="${(2/5) * gummy_sphere_mass * gummy_sphere_radius * gummy_sphere_radius}" />
      </inertial>
    </link>

    <!-- LEFT joint: Y-axis rotation (perpendicular to left branch direction) -->
    <joint name="$(arg namespace)/pole_tip_joint_left" type="revolute">
      <parent link="$(arg namespace)/branch_pole_left"/>
      <child link="$(arg namespace)/gummy_sphere_left"/>
      <origin xyz="0 -${branch_pole_length} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <!-- Limited range - acts as compliance and force measurement point -->
      <limit lower="-0.1" upper="0.1" effort="100" velocity="0.0"/>
      <dynamics damping="80.0" friction="20.0"/>
    </joint>

    <!-- Gazebo plugin configuration for LEFT joint -->
    <gazebo reference="$(arg namespace)/pole_tip_joint_left">
      <provideFeedback>true</provideFeedback>
      <implicitSpringDamper>true</implicitSpringDamper>
      <stopCfm>${gummy_contact_cfm}</stopCfm>
      <stopErp>${gummy_contact_erp}</stopErp>
    </gazebo>

    <!-- LEFT Force/Torque Sensor Plugin -->
    <!-- Publishes to: /[namespace]/force_sensor_left/sensor_readings -->
    <gazebo>
      <plugin name="ft_sensor_left" filename="libgazebo_ros_ft_sensor.so">
        <updateRate>1000</updateRate>
        <topicName>$(arg namespace)/force_sensor_left/sensor_readings</topicName>
        <jointName>$(arg namespace)/pole_tip_joint_left</jointName>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </plugin>
    </gazebo>

    <!-- Gazebo material and contact properties for LEFT sphere -->
    <gazebo reference="$(arg namespace)/gummy_sphere_left">
      <material>
        <ambient>0.95 0.6 0.7 1</ambient>
        <diffuse>0.95 0.6 0.7 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
      <surface>
        <friction>
          <ode>
            <mu>${gummy_friction}</mu>
            <mu2>${gummy_friction}</mu2>
            <slip1>0.3</slip1>
            <slip2>0.3</slip2>
          </ode>
        </friction>
        <bounce>
          <restitution_coefficient>${gummy_restitution}</restitution_coefficient>
          <threshold>100000.0</threshold>
        </bounce>
        <contact>
          <ode>
            <min_depth>0.45</min_depth>
            <kp>50</kp>
            <kd>2000</kd>
            <soft_cfm>${gummy_contact_cfm}</soft_cfm>
            <soft_erp>${gummy_contact_erp}</soft_erp>
            <max_vel>0.0001</max_vel>
          </ode>
        </contact>
      </surface>
    </gazebo>

    <!-- ========== RIGHT BRANCH POLE ========== -->

    <link name="$(arg namespace)/branch_pole_right">
      <visual>
        <origin xyz="0 ${branch_pole_length/2} 0" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="${branch_pole_length}" radius="${pole_radius}" />
        </geometry>
        <material name="magenta">
          <color rgba="1 0 1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 ${branch_pole_length/2} 0" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="${branch_pole_length}" radius="${pole_radius}" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 ${branch_pole_length/2} 0" rpy="1.57 0 0"/>
        <mass value="${branch_mass}" />
        <inertia 
          ixx="${(1/12) * branch_mass * (3*pole_radius*pole_radius + branch_pole_length*branch_pole_length)}" 
          ixy="0.0" 
          ixz="0.0"
          iyy="${(1/12) * branch_mass * (3*pole_radius*pole_radius + branch_pole_length*branch_pole_length)}" 
          iyz="0.0" 
          izz="${(1/2) * branch_mass * (pole_radius*pole_radius)}" />
      </inertial>
    </link>

    <joint name="$(arg namespace)/branch_joint_right" type="fixed">
      <parent link="$(arg namespace)/branch_junction"/>
      <child link="$(arg namespace)/branch_pole_right"/>
      <origin xyz="0 -${branch_offset} 0" rpy="0 0 0"/>
    </joint>

    <!-- ========== RIGHT SOFT GUMMY SPHERE ========== -->

    <link name="$(arg namespace)/gummy_sphere_right">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${gummy_sphere_radius}"/>
        </geometry>
        <material name="gummy_pink">
          <color rgba="0.95 0.6 0.7 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${gummy_sphere_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${gummy_sphere_mass}"/>
        <inertia 
          ixx="${(2/5) * gummy_sphere_mass * gummy_sphere_radius * gummy_sphere_radius}" 
          ixy="0.0" 
          ixz="0.0"
          iyy="${(2/5) * gummy_sphere_mass * gummy_sphere_radius * gummy_sphere_radius}" 
          iyz="0.0"
          izz="${(2/5) * gummy_sphere_mass * gummy_sphere_radius * gummy_sphere_radius}" />
      </inertial>
    </link>

    <!-- RIGHT joint: Y-axis rotation (SAME axis as LEFT for consistency) -->
    <!-- CRITICAL: This ensures BOTH sensors measure forces in the same direction -->
    <!-- The Z-axis approach caused the right sensor to measure opposite -->
    <joint name="$(arg namespace)/pole_tip_joint_right" type="revolute">
      <parent link="$(arg namespace)/branch_pole_right"/>
      <child link="$(arg namespace)/gummy_sphere_right"/>
      <origin xyz="0 ${branch_pole_length} 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0" />
      <limit lower="-0.1" upper="0.1" effort="100" velocity="0.0"/>
      <dynamics damping="80.0" friction="20.0"/>
    </joint>

    <!-- Gazebo plugin configuration for RIGHT joint -->
    <gazebo reference="$(arg namespace)/pole_tip_joint_right">
      <provideFeedback>true</provideFeedback>
      <implicitSpringDamper>true</implicitSpringDamper>
      <stopCfm>${gummy_contact_cfm}</stopCfm>
      <stopErp>${gummy_contact_erp}</stopErp>
    </gazebo>

    <!-- RIGHT Force/Torque Sensor Plugin -->
    <!-- Publishes to: /[namespace]/force_sensor_right/sensor_readings -->
    <gazebo>
      <plugin name="ft_sensor_right" filename="libgazebo_ros_ft_sensor.so">
        <updateRate>1000</updateRate>
        <topicName>$(arg namespace)/force_sensor_right/sensor_readings</topicName>
        <jointName>$(arg namespace)/pole_tip_joint_right</jointName>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </plugin>
    </gazebo>

    <!-- Gazebo material and contact properties for RIGHT sphere -->
    <gazebo reference="$(arg namespace)/gummy_sphere_right">
      <material>
        <ambient>0.95 0.6 0.7 1</ambient>
        <diffuse>0.95 0.6 0.7 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
      <surface>
        <friction>
          <ode>
            <mu>${gummy_friction}</mu>
            <mu2>${gummy_friction}</mu2>
            <slip1>0.3</slip1>
            <slip2>0.3</slip2>
          </ode>
        </friction>
        <bounce>
          <restitution_coefficient>${gummy_restitution}</restitution_coefficient>
          <threshold>100000.0</threshold>
        </bounce>
        <contact>
          <ode>
            <soft_cfm>${gummy_contact_cfm}</soft_cfm>
            <soft_erp>${gummy_contact_erp}</soft_erp>
            <kp>50</kp>
            <kd>2000</kd>
            <max_vel>0.1</max_vel>
            <min_depth>0.45</min_depth>
          </ode>
        </contact>
      </surface>
    </gazebo>

    <!-- ========== BACKWARD COMPATIBILITY DUMMY LINK ========== -->
    
    <link name="pole_tip">
      <inertial>
        <mass value="0.0001"/>
        <inertia ixx="1e-8" ixy="0.0" ixz="0.0" iyy="1e-8" iyz="0.0" izz="1e-8"/>
      </inertial>
    </link>

    <joint name="pole_tip_dummy_joint" type="fixed">
      <parent link="$(arg namespace)/gummy_sphere_left"/>
      <child link="pole_tip"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:if>

</robot>